# MySQL（本地默认 root/root），库名与集团财务分开
DATABASE_URL="mysql://root:root@localhost:3306/personal_finance"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"
PORT=3020

# ── AI 辅助录入 ──
# AI_PROVIDER：platform（以虎 One 平台模型，平台上有 YH_CLIENT_ID + YH_CLIENT_SECRET 时默认走这个）/ claude-cli（本机默认，复用已登录的 claude 命令行，无需 Key）/ anthropic（用 API Key）/ off（只用规则解析）/ stub（不调模型，测试和本地联调用）
AI_PROVIDER="claude-cli"
# claude-cli 用的模型别名（haiku 快、sonnet 准）
AI_CLI_MODEL="sonnet"
# AI_PROVIDER=anthropic 时需要
# ANTHROPIC_API_KEY=""
# platform / anthropic 用的模型：anthropic 默认 claude-opus-5，platform 不配就用平台默认
# AI_MODEL="claude-opus-5"

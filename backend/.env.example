# MySQL（本地默认 root/root），库名与集团财务分开
DATABASE_URL="mysql://root:root@localhost:3306/personal_finance"
JWT_SECRET="change-me"
JWT_EXPIRES_IN="30d"
PORT=3020

# ── AI 辅助录入 ──
# AI_PROVIDER：claude-cli（默认，复用本机已登录的 claude 命令行，无需 Key）/ anthropic（用 API Key）/ off（只用规则解析）
AI_PROVIDER="claude-cli"
# claude-cli 用的模型别名（haiku 快、sonnet 准）
AI_CLI_MODEL="sonnet"
# AI_PROVIDER=anthropic 时需要
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5"
